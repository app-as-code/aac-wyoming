# Copy to .env and set every CHANGE_ME:  cp .env.example .env

# default: Wyoming Voice
CUSTOM_NAME=Wyoming Voice

# default: 1000
PGID=1000

# default: 1000
PUID=1000

# default: example.com
SERVICE_DOMAIN_NAME=example.com

# default: aac-wyoming
SERVICE_HOSTNAME=aac-wyoming

# default: latest
SERVICE_IMAGE_TAG=latest

# default: aac-wyoming
SERVICE_NAME=aac-wyoming

# default: aac-wyoming
SERVICE_NAME_LOWERCASE=aac-wyoming

# default: Europe/Berlin
TZ=Europe/Berlin
